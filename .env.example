# Environment Variables Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# =============================================================================
# GitHub Bot Configuration (for automated data updates)
# =============================================================================

# Personal Access Token for GitHub bot (optional for local development)
# Required for: Automated commits in GitHub Actions
# Scope needed: repo (full control of private repositories)
# Generate at: https://github.com/settings/tokens
GITHUB_BOT_TOKEN=

# Repository information
GITHUB_REPO=nathan-judges/footy-tipping
GITHUB_BRANCH=main

# Bot identity for commits
GITHUB_BOT_NAME=tipping-bot[bot]
GITHUB_BOT_EMAIL=tipping-bot@users.noreply.github.com

# =============================================================================
# External API Keys
# =============================================================================

# The Odds API key (optional for local development)
# Required for: Fetching live betting odds
# Get your key at: https://the-odds-api.com/
# Free tier: 500 requests/month
ODDS_API_KEY=

# =============================================================================
# Development Settings (optional)
# =============================================================================

# Set to 'development' for local dev, 'production' for deployed
NODE_ENV=development

# Python path for scripts (usually auto-detected)
# PYTHONPATH=.
